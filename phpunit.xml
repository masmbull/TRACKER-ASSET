<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- APP_ENV is the one variable a surrounding host can get wrong.
             docker compose injects APP_ENV=local into the container, and
             Laravel's env() reads $_SERVER (the real environment) first - so
             the <env> entry below, even with force, cannot override it:
             putenv/$_ENV are rewritten, $_SERVER is not. With env() seeing
             "local", VerifyCsrfToken's runningUnitTests() escape hatch stays
             off and every POST in the suite fails with 419. <server> writes
             $_SERVER directly, which is the surface Laravel actually reads. -->
        <env name="APP_ENV" value="testing" force="true"/>
        <server name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- The health-endpoint probe performs a real HTTP call to APP_URL, so
             leaving it on made the suite report a healthy fleet as broken
             whenever no dev server happened to be running. -->
        <env name="SERVICES_PROBE_HEALTH_ENDPOINT" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
