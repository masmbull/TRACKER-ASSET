<Project Sdk="Microsoft.NET.Sdk">

  <!-- Offline harness for the agent's non-UI logic. No test framework on
       purpose: the machine this has to run on has no NuGet feed configured (a
       `dotnet restore` for xunit/mstest fails here), and the two defects worth
       pinning need nothing more than assertions and a JsonDocument.

       Run: agent\TrackerAgent.Tests\run.bat
            (or: dotnet run from the agent\TrackerAgent.Tests directory) -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TrackerAgent.Tests</AssemblyName>
    <RootNamespace>TrackerAgent.Tests</RootNamespace>
    <!-- The harness is never shipped; do not let a publish pick it up. -->
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrackerAgent\TrackerAgent.csproj" />
  </ItemGroup>

</Project>