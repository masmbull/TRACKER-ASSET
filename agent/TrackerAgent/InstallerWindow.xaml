<Window x:Class="TrackerAgent.InstallerWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Title="TRACKER-ASSET Setup"
         Icon="mito-icon.png"
         Width="760" Height="Auto"
         MinWidth="760" MinHeight="560"
         SizeToContent="Height"
         WindowStartupLocation="CenterScreen"
         ResizeMode="NoResize"
         FontFamily="Segoe UI"
         UseLayoutRounding="True"
         TextOptions.TextFormattingMode="Display"
         Background="#F3F4F6"
         WindowStyle="SingleBorderWindow">

    <!-- Light, document-like installer surface.
         The previous window was a dark, borderless, transparency-enabled card
         with red glows. It read as a game launcher rather than a setup wizard,
         and AllowsTransparency forced software rendering for every frame of the
         shimmer animation. This follows the Windows 11 setup conventions instead:
         a single light surface, one accent colour used only for the primary
         action and the progress fill, and a real title bar the user can move. -->
    <Window.Resources>
        <!-- Accent: the MITO red, used sparingly. -->
        <SolidColorBrush x:Key="BrandBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="BrandHover" Color="#B91C1C"/>
        <SolidColorBrush x:Key="BrandPressed" Color="#991B1B"/>

        <!-- Semantic status colours, light-surface variants (600/700 weights). -->
        <SolidColorBrush x:Key="SuccessBrush" Color="#047857"/>
        <SolidColorBrush x:Key="SuccessSoftBrush" Color="#ECFDF5"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#B42318"/>
        <SolidColorBrush x:Key="ErrorSoftBrush" Color="#FEF3F2"/>
        <SolidColorBrush x:Key="RunningBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="RunningSoftBrush" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="PendingBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="PendingSoftBrush" Color="#F3F4F6"/>

        <!-- Text: three levels, all dark-on-light. -->
        <SolidColorBrush x:Key="NeutralTextBrush" Color="#101828"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#344054"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#667085"/>

        <!-- Surfaces and lines. -->
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E4E7EC"/>
        <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="TrackBrush" Color="#EAECF0"/>
        <SolidColorBrush x:Key="FillBrush" Color="#DC2626"/>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource BrandBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="{StaticResource BrandHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="{StaticResource BrandPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBg" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="{StaticResource SubtleSurfaceBrush}"/>
                                <Setter TargetName="BtnBg" Property="BorderBrush" Value="#98A2B3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#EAECF0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One checklist row. Kept flat and quiet: the state is carried by a
             small glyph and a text label, not by a coloured card per step. -->
        <DataTemplate x:Key="StepCardTemplate">
            <Border Background="Transparent"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusGlyph}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{Binding StatusIconBrush}"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Margin="8,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="13"
                                   Foreground="{Binding StatusTextBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Description}"
                                   FontSize="11.5"
                                   Foreground="{Binding DescriptionBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="2"
                            Background="{Binding BadgeBrush}"
                            CornerRadius="10"
                            Padding="8,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusLabel}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding BadgeTextBrush}"
                                   TextWrapping="NoWrap"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border Background="#F3F4F6" Padding="24">
        <Border x:Name="MainCard"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="12" Opacity="0.06" Color="#101828"/>
            </Border.Effect>

            <Grid Margin="28,24,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8"
                            Background="{StaticResource BrandBrush}">
                        <Image Source="mito-logo-white.png" Width="30" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TRACKER-ASSET"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource NeutralTextBrush}"/>
                        <TextBlock x:Name="SubtitleText"
                                   Text="Instalasi agen"
                                   FontSize="12.5"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Heading and description -->
                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                    <TextBlock x:Name="InstallHeadingText" Text="Memasang TrackerAgent"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource NeutralTextBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="DescriptionText"
                               Text="Jangan tutup jendela ini sampai proses selesai."
                               FontSize="12.5"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Checklist -->
                <Border Grid.Row="2"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="6"
                        Padding="16,6">
                    <StackPanel x:Name="InstallStepsPanel">
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="StepIcon1" Grid.Column="0" Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource PendingBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StepLabel1" Grid.Column="1" Margin="8,0,16,0" Text="Memeriksa koneksi server" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StepState1" Grid.Column="2" Text="Menunggu" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource CardBorderBrush}"/>
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="StepIcon2" Grid.Column="0" Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource PendingBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StepLabel2" Grid.Column="1" Margin="8,0,16,0" Text="Menyiapkan folder dan menyalin agent" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StepState2" Grid.Column="2" Text="Menunggu" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource CardBorderBrush}"/>
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="StepIcon3" Grid.Column="0" Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource PendingBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StepLabel3" Grid.Column="1" Margin="8,0,16,0" Text="Membuat identitas perangkat" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StepState3" Grid.Column="2" Text="Menunggu" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource CardBorderBrush}"/>
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="StepIcon4" Grid.Column="0" Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource PendingBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StepLabel4" Grid.Column="1" Margin="8,0,16,0" Text="Mendaftarkan perangkat ke server" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StepState4" Grid.Column="2" Text="Menunggu" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource CardBorderBrush}"/>
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="StepIcon5" Grid.Column="0" Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource PendingBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StepLabel5" Grid.Column="1" Margin="8,0,16,0" Text="Mengatur agent berjalan saat login" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StepState5" Grid.Column="2" Text="Menunggu" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource CardBorderBrush}"/>
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="StepIcon6" Grid.Column="0" Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource PendingBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StepLabel6" Grid.Column="1" Margin="8,0,16,0" Text="Menjalankan agent di system tray" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StepState6" Grid.Column="2" Text="Menunggu" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Install button (kept for the manual path) -->
                <Button x:Name="InstallButton" Grid.Row="3" Visibility="Collapsed"
                        Content="Install Now" Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Right" Margin="0,16,0,0"/>

                <!-- Progress bar -->
                <Border x:Name="OverallProgressTrack" Grid.Row="4"
                        Background="{StaticResource TrackBrush}"
                        Height="6"
                        CornerRadius="3"
                        Margin="0,20,0,0"
                        Visibility="Visible">
                    <Grid ClipToBounds="True">
                        <Rectangle x:Name="OverallProgressFill" Fill="{StaticResource FillBrush}"
                                   Width="0" HorizontalAlignment="Left" RadiusX="3" RadiusY="3"/>
                        <Border x:Name="ShimmerBar" Width="100" HorizontalAlignment="Left"
                                Background="#33FFFFFF" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ShimmerTransform" X="-140"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </Border>

                <!-- Status line -->
                <Grid x:Name="StatsPanel" Grid.Row="5" Margin="0,10,0,0" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Grid.Column="0" Text="Menyiapkan instalasi..."
                               FontSize="12.5" Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PercentText" Grid.Column="1" Text="0%" Margin="12,0,0,0"
                               FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"
                               VerticalAlignment="Center"/>
                </Grid>

                <TextBlock x:Name="ProgressCounterText" Grid.Row="6"
                           Text="0 dari 6 langkah selesai"
                           FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Left"
                           Margin="0,6,0,0"
                           VerticalAlignment="Top"/>
                <ScrollViewer x:Name="StepsScrollViewer" Grid.Row="6"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="220"
                              Margin="0,26,0,0"
                              Visibility="Collapsed">
                    <ItemsControl x:Name="StepCards">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <StaticResource ResourceKey="StepCardTemplate"/>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Result panel: below the checklist, never on top of it.
                     It used to span rows 5-7 and cover the steps, progress bar and
                     status line, so a failure looked like a frozen window with a
                     second dialog stacked in the middle. -->
                <Border x:Name="ResultPanel" Grid.Row="7"
                        Background="{StaticResource SubtleSurfaceBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="6"
                        Padding="20,16"
                        Margin="0,18,0,0"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="36" Height="36" Margin="0,2,14,0"
                              VerticalAlignment="Top">
                            <Ellipse x:Name="ResultBadge" Width="36" Height="36">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="#ECFDF5"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock x:Name="ResultIcon"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Foreground="{StaticResource SuccessBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="&#xE73E;"/>
                        </Grid>

                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="ResultText" Text="Instalasi selesai"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource NeutralTextBrush}"
                                       TextWrapping="Wrap"/>

                            <TextBlock x:Name="ResultDetail"
                                       FontSize="12.5"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="19"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Buttons -->
                <StackPanel Grid.Row="8" Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">
                    <Button x:Name="RetryButton" Content="Ulangi" Visibility="Collapsed"
                            Margin="0,0,10,0" Style="{StaticResource GhostButtonStyle}"
                            Click="RetryButton_Click"/>
                    <Button x:Name="CloseButton" Content="Tutup" Visibility="Collapsed"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
