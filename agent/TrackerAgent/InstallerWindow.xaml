<Window x:Class="TrackerAgent.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TRACKER-ASSET Audit Agent"
        Width="520" Height="320"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1e293b"
        AllowsTransparency="False">

    <Window.Resources>
        <!-- Constant motion across the bar so a long-running step (device
             registration, first scan) never looks like a frozen window. -->
        <Storyboard x:Key="ShimmerStoryboard">
            <DoubleAnimation Storyboard.TargetName="ShimmerTransform"
                             Storyboard.TargetProperty="X"
                             From="-200" To="420"
                             Duration="0:0:1.8"
                             RepeatBehavior="Forever"/>
        </Storyboard>
    </Window.Resources>

    <Grid Margin="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="TRACKER-ASSET" FontSize="26" FontWeight="Bold" Foreground="#3b82f6">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#3b82f6" BlurRadius="8" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="Zero-configuration agent install" FontSize="13" Foreground="#94a3b8" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Progress: the only UI while installing (no URL / token input) -->
        <StackPanel Grid.Row="1" x:Name="StatusPanel" VerticalAlignment="Center">
            <TextBlock x:Name="StatusText" Text="Starting installation..." Foreground="#e2e8f0"
                       FontSize="15" Margin="0,0,0,16" TextWrapping="Wrap" TextAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#e2e8f0" BlurRadius="4" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>

            <Border Background="#0f172a" BorderBrush="#334155" BorderThickness="1"
                    CornerRadius="14" ClipToBounds="True" Height="28">
                <Border.Effect>
                    <DropShadowEffect Color="#3b82f6" BlurRadius="8" ShadowDepth="0"/>
                </Border.Effect>
                <Grid>
                    <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Value="0"
                                 Background="Transparent" BorderThickness="0" Foreground="#3b82f6"/>
                    <Rectangle Width="160" Opacity="0.30" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#FFFFFFFF" Offset="0.5"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="ShimmerTransform" X="-200"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
            </Border>

            <TextBlock x:Name="PercentText" Text="0%" Foreground="#94a3b8"
                       FontSize="14" HorizontalAlignment="Center" Margin="0,12,0,0" FontWeight="Medium"/>
        </StackPanel>

        <!-- Result (hidden until finished) -->
        <StackPanel Grid.Row="1" x:Name="ResultPanel" Visibility="Collapsed" VerticalAlignment="Center">
            <TextBlock x:Name="ResultIcon" FontSize="54" HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#3b82f6" BlurRadius="12" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock x:Name="ResultText" FontSize="18" FontWeight="SemiBold" Foreground="#e2e8f0"
                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock x:Name="ResultDetail" FontSize="13" Foreground="#94a3b8" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="400" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Buttons appear only when the user has to do something -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="RetryButton" Content="Retry" Width="120" Height="38" Visibility="Collapsed"
                    Background="#3b82f6" Foreground="White" FontWeight="SemiBold" FontSize="14"
                    BorderThickness="0" Cursor="Hand" Click="RetryButton_Click"/>
            <Button x:Name="CloseButton" Content="Close" Width="100" Height="38" Margin="12,0,0,0" Visibility="Collapsed"
                    Background="#475569" Foreground="White" BorderThickness="0" FontSize="14"
                    Cursor="Hand" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
