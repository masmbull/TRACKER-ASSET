<Window x:Class="TrackerAgent.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TRACKER-ASSET Audit Agent"
        Width="520" Height="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1e293b"
        AllowsTransparency="False">

    <Window.Resources>
        <Storyboard x:Key="PulseStoryboard">
            <DoubleAnimation Storyboard.TargetName="StatusText" 
                             Storyboard.TargetProperty="Opacity" 
                             From="1" To="0.5" 
                             Duration="0:0:1" 
                             AutoReverse="True" 
                             RepeatBehavior="Forever"/>
        </Storyboard>
    </Window.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="TRACKER-ASSET" FontSize="28" FontWeight="Bold" Foreground="#3b82f6">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#3b82f6" BlurRadius="8" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="Mito Audit Tracker" FontSize="16" Foreground="#94a3b8" Margin="0,6,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#94a3b8" BlurRadius="4" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>

        <!-- Status area (shown immediately) -->
        <StackPanel Grid.Row="1" x:Name="StatusPanel" VerticalAlignment="Center">
            <TextBlock x:Name="StatusText" Text="Detecting server..." Foreground="#e2e8f0"
                       FontSize="15" Margin="0,0,0,16" TextWrapping="Wrap" HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#e2e8f0" BlurRadius="4" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>
            <ProgressBar x:Name="ProgressBar" Height="28" Minimum="0" Maximum="100"
                         Background="#0f172a" Foreground="#3b82f6" BorderBrush="#334155" BorderThickness="1" IsIndeterminate="True">
                <ProgressBar.Effect>
                    <DropShadowEffect Color="#3b82f6" BlurRadius="8" ShadowDepth="0"/>
                </ProgressBar.Effect>
            </ProgressBar>
            <TextBlock x:Name="PercentText" Text="Auto-detecting..." Foreground="#94a3b8"
                       FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,0" FontWeight="Medium">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#94a3b8" BlurRadius="4" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>

        <!-- Result (hidden until done) -->
        <StackPanel Grid.Row="1" x:Name="ResultPanel" Visibility="Collapsed" VerticalAlignment="Center" TextBlock.TextAlignment="Center">
            <TextBlock x:Name="ResultIcon" FontSize="64" HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#3b82f6" BlurRadius="12" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock x:Name="ResultText" FontSize="18" FontWeight="SemiBold"
                       Foreground="#e2e8f0" HorizontalAlignment="Center" Margin="0,12,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#e2e8f0" BlurRadius="4" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock x:Name="ResultDetail" FontSize="13" Foreground="#94a3b8"
                       HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="400">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#94a3b8" BlurRadius="4" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="InstallButton" Content="Install" Width="140" Height="40"
                    Background="#3b82f6" Foreground="White" FontWeight="SemiBold" FontSize="14"
                    BorderThickness="0" Cursor="Hand" Click="InstallButton_Click">
                <Button.Effect>
                    <DropShadowEffect Color="#3b82f6" BlurRadius="8" ShadowDepth="2"/>
                </Button.Effect>
            </Button>
            <Button x:Name="CloseButton" Content="Close" Width="100" Height="40" Margin="12,0,0,0"
                    Background="#475569" Foreground="White" BorderThickness="0" FontSize="14"
                    Cursor="Hand" Visibility="Collapsed" Click="CloseButton_Click">
                <Button.Effect>
                    <DropShadowEffect Color="#475569" BlurRadius="4" ShadowDepth="2"/>
                </Button.Effect>
            </Button>
        </StackPanel>
    </Grid>
</Window>