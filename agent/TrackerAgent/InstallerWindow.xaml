<Window x:Class="TrackerAgent.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TRACKER-ASSET"
        Icon="mito-icon.png"
        Width="540" Height="410"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="#F3F6FB"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <SolidColorBrush x:Key="BrandBrush" Color="#1F5EFF"/>
        <SolidColorBrush x:Key="BrandDarkBrush" Color="#1737A6"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#1F9D60"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#E5484D"/>
        <SolidColorBrush x:Key="NeutralTextBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#5B6472"/>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource BrandBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrandDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="18" Background="White" CornerRadius="18" BorderBrush="#D8E0F0" BorderThickness="1">
        <Grid Margin="28,22,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#EEF4FF" BorderBrush="#D8E0F0" BorderThickness="1" CornerRadius="12" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="TRACKER-ASSET" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource NeutralTextBrush}"/>
                    <TextBlock x:Name="SubtitleText" Text="Installing..." FontSize="13" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="0,24,0,0">
                <StackPanel x:Name="StatusPanel" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="Starting..." FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource NeutralTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                    <Border Background="#F5F7FB" BorderBrush="#D8E0F0" BorderThickness="1" Height="18" CornerRadius="9" ClipToBounds="True">
                        <Rectangle x:Name="ProgressFill" Fill="{StaticResource BrandBrush}" Width="0" HorizontalAlignment="Left" RadiusX="9" RadiusY="9"/>
                    </Border>

                    <TextBlock x:Name="PercentText" Text="0%" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource NeutralTextBrush}" HorizontalAlignment="Right" Margin="0,12,0,0"/>
                </StackPanel>

                <StackPanel x:Name="ResultPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="84" Height="84" Background="#F3F9F6" BorderBrush="#CFE6DA" BorderThickness="1" CornerRadius="42" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <TextBlock x:Name="ResultIcon" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock x:Name="ResultText" Text="Done" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource NeutralTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock x:Name="ResultDetail" Text="Agent ready" FontSize="13" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="RetryButton" Content="Retry" Visibility="Collapsed" Margin="0,0,10,0" Style="{StaticResource PrimaryButtonStyle}" Background="{StaticResource BrandBrush}" Click="RetryButton_Click"/>
                <Button x:Name="CloseButton" Content="Close" Visibility="Collapsed" Style="{StaticResource PrimaryButtonStyle}" Background="{StaticResource BrandDarkBrush}" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
