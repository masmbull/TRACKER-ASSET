<Window x:Class="TrackerAgent.InstallerWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Title="TRACKER-ASSET Setup"
         Icon="mito-icon.png"
         Width="720" Height="Auto"
         MinWidth="720" MinHeight="520"
         SizeToContent="Height"
         WindowStartupLocation="CenterScreen"
         ResizeMode="NoResize"
         FontFamily="Segoe UI"
         UseLayoutRounding="True"
         TextOptions.TextFormattingMode="Display"
         Background="Transparent"
         WindowStyle="None"
         AllowsTransparency="True">

    <Window.Resources>
        <SolidColorBrush x:Key="BrandBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="BrandHover" Color="#B91C1C"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="PendingBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="RunningBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="SkippedBrush" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="NeutralTextBrush" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#D1D5DB"/>
        <SolidColorBrush x:Key="CardBrush" Color="#11131B"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="TrackBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="FillBrush" Color="#DC2626"/>

        <Thickness x:Key="CardPadding" Left="24" Top="24" Right="24" Bottom="24"/>

        <Storyboard x:Key="GlowLoop">
            <DoubleAnimation Storyboard.TargetName="GlowBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0.2" To="0.4"
                             Duration="0:0:2"
                             AutoReverse="True"
                             RepeatBehavior="Forever"/>
        </Storyboard>

        <Storyboard x:Key="CardFloatIn">
            <DoubleAnimation Storyboard.TargetName="MainCard"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.4"/>
            <DoubleAnimation Storyboard.TargetName="MainCard"
                             Storyboard.TargetProperty="(TranslateTransform.Y)"
                             From="20" To="0"
                             Duration="0:0:0.4"/>
        </Storyboard>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="28,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource BrandBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrandHover}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="12" Opacity="0.35" Color="#DC2626"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="{StaticResource BrandHover}"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#7F1D1D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="28,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource CardBorderBrush}"/>
                                <Setter Property="BorderBrush" Value="#6B7280"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="StepCardTemplate">
            <Border Background="{Binding BackgroundBrush}"
                    BorderBrush="{Binding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Margin="0,0,0,8">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="{Binding GlowBlur}" Opacity="{Binding GlowOpacity}" Color="#3B82F6"/>
                </Border.Effect>
                <Grid Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Ellipse Grid.Column="0" Grid.RowSpan="2"
                             Width="40" Height="40"
                             Fill="{Binding StatusIconBrush}"
                             Stroke="{Binding BorderBrush}"
                             StrokeThickness="2">
                        <Ellipse.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="{Binding IconGlowBlur}" Opacity="{Binding IconGlowOpacity}" Color="#3B82F6"/>
                        </Ellipse.Effect>
                        <Ellipse>
                            <TextBlock Text="{Binding StatusGlyph}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Ellipse>
                    </Ellipse>

                    <TextBlock Grid.Column="1" Grid.Row="0"
                               Text="{Binding Title}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{Binding StatusTextBrush}"/>

                    <TextBlock Grid.Column="1" Grid.Row="1"
                               Text="{Binding Description}"
                               FontSize="11.5"
                               Foreground="{Binding DescriptionBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Left"
                               Margin="0,4,0,0"/>

                    <Border Grid.Column="2" Grid.RowSpan="2"
                            Background="{Binding BadgeBrush}"
                            CornerRadius="20"
                            Padding="12,4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusLabel}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding BadgeTextBrush}"
                                   TextWrapping="NoWrap"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="StatLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource NeutralTextBrush}"/>
        </Style>
    </Window.Resources>

    <Border x:Name="GlowBorder" Background="Transparent"
            MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Border x:Name="MainCard"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                CornerRadius="20"
                RenderTransformOrigin="0.5,0.5">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="40" Opacity="0.3" Color="#000000"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardTranslate" Y="0"/>
            </Border.RenderTransform>

            <Grid Margin="32,28,32,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="16"
                            Background="{StaticResource BrandBrush}">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="16" Opacity="0.4" Color="#DC2626"/>
                        </Border.Effect>
                        <TextBlock Text="M"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TRACKER-ASSET"
                                   FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource NeutralTextBrush}"/>
                        <TextBlock x:Name="SubtitleText"
                                   Text="Installation Wizard"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Ready State -->
                <Border x:Name="ReadyPanel" Grid.Row="1"
                        Background="#0F1117"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="14"
                        Padding="32"
                        HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="16" Opacity="0.15" Color="#DC2626"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Ready to Install"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DescriptionText"
                                   Text="TRACKER-ASSET agent will be installed and registered with the server."
                                   FontSize="13"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="500"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Install Button -->
                <Button x:Name="InstallButton" Grid.Row="2"
                        Content="Install Now"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Center"
                        Margin="0,16,0,0"
                        Click="InstallButton_Click"/>

                <!-- Progress Bar -->
                <Border x:Name="OverallProgressTrack" Grid.Row="3"
                        Background="{StaticResource TrackBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        Height="8"
                        CornerRadius="4"
                        Visibility="Collapsed">
                    <Border.Clip>
                        <RectangleGeometry Rect="0,0,560,8"/>
                    </Border.Clip>
                    <Rectangle x:Name="OverallProgressFill"
                               Fill="{StaticResource FillBrush}"
                               Width="0"
                               HorizontalAlignment="Left"
                               RadiusX="4" RadiusY="4"/>
                </Border>

                <!-- Progress Stats -->
                <Grid x:Name="StatsPanel" Grid.Row="4" Margin="0,12,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Total" Style="{StaticResource StatLabelStyle}"/>
                        <TextBlock x:Name="TotalStepsText" Text="0" Style="{StaticResource StatValueStyle}" Margin="6,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="40,0,0,0">
                        <TextBlock Text="Complete" Style="{StaticResource StatLabelStyle}"/>
                        <TextBlock x:Name="CompletedText" Text="0" Style="{StaticResource StatValueStyle}" Margin="6,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="40,0,0,0">
                        <TextBlock Text="Running" Style="{StaticResource StatLabelStyle}"/>
                        <TextBlock x:Name="RunningText" Text="0" Style="{StaticResource StatValueStyle}" Margin="6,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="40,0,0,0">
                        <TextBlock Text="Failed" Style="{StaticResource StatLabelStyle}"/>
                        <TextBlock x:Name="FailedText" Text="0" Style="{StaticResource StatValueStyle}" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Progress Counter -->
                <TextBlock x:Name="ProgressCounterText" Grid.Row="5"
                           Text="0 of 0 steps completed"
                           FontSize="13"
                           Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>

                <!-- Step Cards List -->
                <ScrollViewer x:Name="StepsScrollViewer" Grid.Row="6"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,8,0,0"
                              Visibility="Collapsed">
                    <ItemsControl x:Name="StepCards">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <StaticResource ResourceKey="StepCardTemplate"/>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Result Panel -->
                <Border x:Name="ResultPanel" Grid.Row="5" Grid.RowSpan="3"
                        Background="#0F1117"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="14"
                        Padding="32"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="24" Opacity="0.2" Color="#DC2626"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <Grid Width="80" Height="80" Margin="0,0,0,18">
                            <Ellipse x:Name="ResultBadge"
                                     Width="80" Height="80"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#22C55E" Offset="0"/>
                                        <GradientStop Color="#16A34A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="16" Opacity="0.4" Color="#22C55E"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="ResultIcon"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="32"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="&#x2713;"/>
                        </Grid>

                        <TextBlock x:Name="ResultText" Text="Install Complete"
                                   FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource NeutralTextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>

                        <TextBlock x:Name="ResultDetail"
                                   FontSize="14"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="500"
                                   Margin="0,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Buttons -->
                <StackPanel Grid.Row="7" Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,0">
                    <Button x:Name="RetryButton" Content="Ulangi" Visibility="Collapsed"
                            Margin="0,0,16,0" Style="{StaticResource GhostButtonStyle}"
                            Click="RetryButton_Click"/>
                    <Button x:Name="CloseButton" Content="Tutup" Visibility="Collapsed"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource CardFloatIn}"/>
        </EventTrigger>
    </Window.Triggers>
</Window>