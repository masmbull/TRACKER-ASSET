<Window x:Class="TrackerAgent.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TRACKER-ASSET Setup"
        Icon="mito-icon.png"
        Width="560" Height="480"
        MinWidth="560" MinHeight="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="#F1F3F9"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <SolidColorBrush x:Key="BrandBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="BrandDarkBrush" Color="#B91C1C"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#15803D"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="NeutralTextBrush" Color="#111827"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#E5E7EB"/>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource BrandBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrandDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrandDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- One card, three stacked rows (header / body / actions). SizeToContent=Height
         means the window grows to fit whatever the body needs, so a long failure
         message or the result panel is never clipped by a fixed frame. -->
    <Border Margin="16" Background="White" CornerRadius="14"
            BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
        <Grid Margin="26,22,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: brand mark + product + state line. -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="10" Background="{StaticResource BrandBrush}">
                    <TextBlock Text="M" FontSize="24" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="TRACKER-ASSET" FontSize="19" FontWeight="SemiBold"
                               Foreground="{StaticResource NeutralTextBrush}"/>
                    <TextBlock x:Name="SubtitleText" Text="Installing…" FontSize="12.5"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Body: progress state and result state share the cell; only one shows. -->
            <Grid Grid.Row="1" Margin="0,24,0,4">
                <StackPanel x:Name="StatusPanel" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="Starting…" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource NeutralTextBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="440" Margin="0,0,0,18"/>

                    <Grid>
                        <Border x:Name="ProgressTrack" Background="#EEF0F5"
                                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                                Height="14" CornerRadius="7" ClipToBounds="True"/>
                        <Rectangle x:Name="ProgressFill" Fill="{StaticResource BrandBrush}"
                                   Width="0" HorizontalAlignment="Left" RadiusX="7" RadiusY="7"/>
                        <!-- Shimmer overlay: sweeps across the track while working -->
                        <Rectangle x:Name="ShimmerBar" Fill="White" Opacity="0.35"
                                   Width="100" HorizontalAlignment="Left" RadiusX="7" RadiusY="7"
                                   Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="ShimmerTransform" X="0"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>

                    <TextBlock x:Name="PercentText" Text="0%" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Right" Margin="0,10,0,0"/>
                </StackPanel>

                <StackPanel x:Name="ResultPanel" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="80" Height="80" Background="#FEF2F2" BorderBrush="#FECACA"
                            BorderThickness="1" CornerRadius="40" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock x:Name="ResultIcon" FontFamily="Segoe MDL2 Assets" FontSize="34"
                                   Foreground="{StaticResource SuccessBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock x:Name="ResultText" Text="Done" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource NeutralTextBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock x:Name="ResultDetail" Text="Agent ready" FontSize="13"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextAlignment="Center" HorizontalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="440"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="RetryButton" Content="Retry" Visibility="Collapsed"
                        Margin="0,0,10,0" Style="{StaticResource GhostButtonStyle}" Click="RetryButton_Click"/>
                <Button x:Name="CloseButton" Content="Close" Visibility="Collapsed"
                        Style="{StaticResource PrimaryButtonStyle}" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>