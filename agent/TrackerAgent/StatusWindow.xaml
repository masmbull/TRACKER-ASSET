<Window x:Class="TrackerAgent.StatusWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Title="TRACKER-ASSET — Status"
         Icon="pack://application:,,,/TrackerAgent;component/mito-icon.png"
         Width="560"
         Height="Auto"
         SizeToContent="Height"
         WindowStartupLocation="CenterScreen"
         ResizeMode="NoResize"
         FontFamily="Segoe UI"
         UseLayoutRounding="True"
         TextOptions.TextFormattingMode="Display"
         WindowStyle="None"
         AllowsTransparency="True"
         Background="Transparent">

    <Window.Resources>
        <!-- Font Awesome 6 Free Solid -->
        <FontFamily x:Key="FontAwesome">pack://application:,,,/TrackerAgent;component/Fonts/fa-solid-900.ttf#Font Awesome 6 Free Solid</FontFamily>

        <!-- Fade-in animation for the whole window -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35"/>
        </Storyboard>

        <!-- Subtle pulse for the status dot -->
        <Storyboard x:Key="StatusPulse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.4" Duration="0:0:2" AutoReverse="True"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeIn}"/>
            <BeginStoryboard Storyboard="{StaticResource StatusPulse}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border CornerRadius="16" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1"
            Padding="24" Margin="20">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="32" Opacity="0.12" Color="#101828"/>
        </Border.Effect>

        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="#F3F4F6"
                        VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/TrackerAgent;component/mito-logo-white.png"
                           Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="TRACKER-ASSET Agent" FontSize="18" FontWeight="Bold"
                               Foreground="#111827"/>
                    <TextBlock Text="MITO Electronic · IT Operations" FontSize="12.5"
                               Foreground="#6B7280" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>

            <Border Height="1" Background="#E5E7EB" Margin="0,0,0,20"/>

            <!-- Info grid: two columns of label/value rows -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding ElementName=ServerText, Path=Text}"
                                Margin="0,0,0,10">
                        <TextBlock Text="&#xf233;" FontFamily="{StaticResource FontAwesome}" FontSize="14"
                                   Foreground="#4B5563" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="SERVER" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#9CA3AF"/>
                            <TextBlock x:Name="ServerText" Text="—" FontSize="13.5" Foreground="#111827"
                                       TextWrapping="Wrap" MaxWidth="220"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding ElementName=InstalledText, Path=Text}"
                                Margin="0,0,0,10">
                        <TextBlock Text="&#xf017;" FontFamily="{StaticResource FontAwesome}" FontSize="14"
                                   Foreground="#4B5563" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="TERPASANG" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#9CA3AF"/>
                            <TextBlock x:Name="InstalledText" Text="—" FontSize="13.5" Foreground="#111827"
                                       TextWrapping="Wrap" MaxWidth="220"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding ElementName=DeviceText, Path=Text}"
                                Margin="0,0,0,10">
                        <TextBlock Text="&#xf390;" FontFamily="{StaticResource FontAwesome}" FontSize="14"
                                   Foreground="#4B5563" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="PERANGKAT" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#9CA3AF"/>
                            <TextBlock x:Name="DeviceText" Text="—" FontSize="13.5" Foreground="#111827"
                                       TextWrapping="Wrap" MaxWidth="220"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding ElementName=UserText, Path=Text}"
                                Margin="0,0,0,10">
                        <TextBlock Text="&#xf007;" FontFamily="{StaticResource FontAwesome}" FontSize="14"
                                   Foreground="#4B5563" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="PENGGUNA" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#9CA3AF"/>
                            <TextBlock x:Name="UserText" Text="—" FontSize="13.5" Foreground="#111827"
                                       TextWrapping="Wrap" MaxWidth="220"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding ElementName=IpText, Path=Text}"
                                Margin="0,0,0,10">
                        <TextBlock Text="&#xf6ff;" FontFamily="{StaticResource FontAwesome}" FontSize="14"
                                   Foreground="#4B5563" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="IP LOKAL" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#9CA3AF"/>
                            <TextBlock x:Name="IpText" Text="—" FontSize="13.5" Foreground="#111827"
                                       TextWrapping="Wrap" MaxWidth="220"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding ElementName=VersionText, Path=Text}"
                                Margin="0,0,0,10">
                        <TextBlock Text="&#xf0e7;" FontFamily="{StaticResource FontAwesome}" FontSize="14"
                                   Foreground="#4B5563" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="VERSI AGENT" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#9CA3AF"/>
                            <TextBlock x:Name="VersionText" Text="—" FontSize="13.5" Foreground="#111827"
                                       TextWrapping="Wrap" MaxWidth="220"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" ToolTip="Agent aktif dan siap menerima perintah"
                                Margin="0,0,0,10">
                        <Ellipse Width="10" Height="10" Fill="#10B981" VerticalAlignment="Center"
                                 Margin="0,0,10,0">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Ellipse.Loaded">
                                    <BeginStoryboard Storyboard="{StaticResource StatusPulse}"/>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <StackPanel>
                            <TextBlock Text="STATUS AGENT" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#9CA3AF"/>
                            <TextBlock x:Name="StatusText" Text="Berjalan" FontSize="13.5"
                                       FontWeight="SemiBold" Foreground="#047857"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" ToolTip="Hak akses ditentukan oleh role user"
                                Margin="0,0,0,10">
                        <TextBlock Text="&#xf3ed;" FontFamily="{StaticResource FontAwesome}" FontSize="14"
                                   Foreground="#4B5563" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="ROLE" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#9CA3AF"/>
                            <TextBlock x:Name="RoleText" Text="Pengguna" FontSize="13.5" Foreground="#111827"
                                       TextWrapping="Wrap" MaxWidth="220"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding ElementName=PublicIpText, Path=Text}"
                                Margin="0,0,0,10">
                        <TextBlock Text="&#xf0ac;" FontFamily="{StaticResource FontAwesome}" FontSize="14"
                                   Foreground="#4B5563" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="IP PUBLIK" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#9CA3AF"/>
                            <TextBlock x:Name="PublicIpText" Text="memeriksa…" FontSize="13.5"
                                       Foreground="#111827" TextWrapping="Wrap" MaxWidth="220"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Height="1" Background="#E5E7EB" Margin="0,20,0,0"/>

            <!-- Footer -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <TextBlock Text="Untuk bantuan teknis, hubungi tim IT." FontSize="11.5"
                           Foreground="#9CA3AF"/>
                <Rectangle Width="1" Height="12" Fill="#E5E7EB" Margin="12,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="TRACKER-ASSET v1.7.37" FontSize="11.5" Foreground="#9CA3AF"/>
            </StackPanel>

            <Button x:Name="CloseBtn" Content="Tutup"
                    HorizontalAlignment="Right" Margin="0,20,0,0"
                    Height="40" Width="110"
                    FontSize="13" FontWeight="SemiBold"
                    Foreground="White" Background="#DC2626"
                    Cursor="Hand" BorderThickness="0"
                    Click="CloseButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                            CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#B91C1C"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#991B1B"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Border>
</Window>
