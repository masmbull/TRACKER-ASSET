<Window x:Class="TrackerAgent.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TRACKER-ASSET STATUS"
        Icon="mito-icon.png"
        Width="540" Height="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="#F3F6FB">

    <Window.Resources>
        <SolidColorBrush x:Key="BrandBrush" Color="#1F5EFF"/>
        <SolidColorBrush x:Key="BrandDarkBrush" Color="#1737A6"/>
        <SolidColorBrush x:Key="NeutralTextBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#5B6472"/>
        <SolidColorBrush x:Key="CardBrush" Color="#F5F7FB"/>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource BrandBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrandDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="18" Background="White" CornerRadius="18" BorderBrush="#D8E0F0" BorderThickness="1">
        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#EEF4FF" BorderBrush="#D8E0F0" BorderThickness="1" CornerRadius="12" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="TRACKER-ASSET" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource NeutralTextBrush}"/>
                    <TextBlock x:Name="VersionText" Text="Agent v1.2.0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Margin="0,18,0,0" Background="#F5F7FB" BorderBrush="#D8E0F0" BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel>
                    <Border Background="White" BorderBrush="#D8E0F0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="SERVER" FontSize="10" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ServerText" Text="http://127.0.0.1:8000" FontSize="12" Foreground="{StaticResource NeutralTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="#D8E0F0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="DEVICE ID" FontSize="10" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DeviceIdText" Text="xxxxxxxx…" FontSize="12" FontFamily="Consolas" Foreground="{StaticResource NeutralTextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="#D8E0F0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="STATUS" FontSize="10" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="StatusText" Text="RUNNING" FontSize="12" Foreground="{StaticResource NeutralTextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="#D8E0F0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="INSTALLED" FontSize="10" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="InstalledText" Text="2026-10-05 17:39" FontSize="12" Foreground="{StaticResource NeutralTextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="#D8E0F0" BorderThickness="1" CornerRadius="10" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="PATH" FontSize="10" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PathText" Text="C:\Users\...\TRACKER" FontSize="11" Foreground="{StaticResource NeutralTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Button Grid.Row="2" x:Name="CloseBtn" Content="Close"
                    Margin="0,16,0,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Center" MinWidth="140"
                    Click="CloseButton_Click"/>
        </Grid>
    </Border>
</Window>
