<Window x:Class="TrackerAgent.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TRACKER-ASSET"
        Icon="mito-icon.png"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="#F9FAFB">

    <!--
        Palette mirrors the web dashboard: brand #DC2626 (red-600), white surface,
        #E4E7EC borders, #101828 ink - the same tokens the CSS brand scale defines.
        One surface only: the merge of the old nested card into the window keeps a
        single border instead of a frame-inside-a-frame.
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="BrandBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="BrandHoverBrush" Color="#B91C1C"/>
        <SolidColorBrush x:Key="InkBrush" Color="#101828"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#667085"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E4E7EC"/>
        <SolidColorBrush x:Key="PageBrush" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#12B76A"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource BrandBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrandHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PageBrush}" Padding="16">
        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="24" Opacity="0.08" Color="#101828"/>
            </Border.Effect>

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

<!-- SERVER gets a full-width row: a server URL is long and does
                     not wrap gracefully in a half column, so it was being clipped
                     exactly when it mattered (checking which server this build
                     points at). Everything else stays in two compact columns. -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="SERVER" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="ServerText" Text="—" Style="{StaticResource FieldValue}"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="STATUS" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Running" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="INSTALLED" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="InstalledText" Text="—" Style="{StaticResource FieldValue}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="USER" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="UserText" Text="—" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="DEVICE" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="DeviceText" Text="—" Style="{StaticResource FieldValue}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0">
                            <TextBlock Text="IP LOCAL" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="IpText" Text="—" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2">
                            <TextBlock Text="IP PUBLIC" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="PublicIpText" Text="checking…" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Border Grid.Row="1" Height="1" Background="{StaticResource BorderBrush}"/>

                <Button Grid.Row="2" x:Name="CloseBtn" Content="Close"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch"
                        Click="CloseButton_Click"/>
            </Grid>
        </Border>
    </Border>
</Window>