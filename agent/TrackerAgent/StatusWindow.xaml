<Window x:Class="TrackerAgent.StatusWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Title="TRACKER-ASSET"
         Icon="mito-icon.png"
         Width="480"
         Height="Auto"
         SizeToContent="Height"
         WindowStartupLocation="CenterScreen"
         ResizeMode="NoResize"
         FontFamily="Segoe UI"
         UseLayoutRounding="True"
         TextOptions.TextFormattingMode="Display"
         WindowStyle="SingleBorderWindow"
         Background="#F3F4F6">

    <!-- Light surface, same language as the setup wizard.
         This window used to be a near-black card with a red button. It is opened
         by the user from the tray, on a corporate desktop, and it should read as a
         status report, not a console. The brand mark carries the identity instead
         of a coloured frame. -->
    <Border Background="#F3F4F6" Padding="20">
        <Border Background="#FFFFFF"
                BorderBrush="#E4E7EC" BorderThickness="1"
                CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="12" Opacity="0.06" Color="#101828"/>
            </Border.Effect>

            <StackPanel Margin="24,22,24,22">
                <!-- Brand -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="#E11D2E">
                        <Image Source="mito-logo-white.png" Width="30" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TRACKER-ASSET" FontSize="17" FontWeight="SemiBold" Foreground="#101828"/>
                        <TextBlock Text="MITO Electronic · IT Operations" FontSize="12" Foreground="#667085" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="#E4E7EC" Margin="0,0,0,16"/>

                <!-- Server and status -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SERVER" FontSize="10" FontWeight="SemiBold" Foreground="#98A2B3"/>
                        <TextBlock x:Name="ServerText" Text="—" FontSize="13" Foreground="#101828"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="STATUS" FontSize="10" FontWeight="SemiBold" Foreground="#98A2B3"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Ellipse Width="8" Height="8" Fill="#12B76A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Berjalan" FontSize="13" FontWeight="SemiBold" Foreground="#047857"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Installed and device -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TERPASANG" FontSize="10" FontWeight="SemiBold" Foreground="#98A2B3"/>
                        <TextBlock x:Name="InstalledText" Text="—" FontSize="13" Foreground="#101828" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="PERANGKAT" FontSize="10" FontWeight="SemiBold" Foreground="#98A2B3"/>
                        <TextBlock x:Name="DeviceText" Text="—" FontSize="13" Foreground="#101828" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- User and version -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PENGGUNA" FontSize="10" FontWeight="SemiBold" Foreground="#98A2B3"/>
                        <TextBlock x:Name="UserText" Text="—" FontSize="13" Foreground="#101828" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="VERSI AGENT" FontSize="10" FontWeight="SemiBold" Foreground="#98A2B3"/>
                        <TextBlock x:Name="VersionText" Text="—" FontSize="13" Foreground="#101828" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="#E4E7EC" Margin="0,0,0,14"/>

                <!-- Addresses -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="IP LOKAL" FontSize="10" FontWeight="SemiBold" Foreground="#98A2B3"/>
                        <TextBlock x:Name="IpText" Text="—" FontSize="13" Foreground="#101828" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="IP PUBLIK" FontSize="10" FontWeight="SemiBold" Foreground="#98A2B3"/>
                        <TextBlock x:Name="PublicIpText" Text="memeriksa..." FontSize="13" Foreground="#101828" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Untuk bantuan teknis, hubungi tim IT."
                           FontSize="11" Foreground="#98A2B3" Margin="0,16,0,0"/>

                <Button x:Name="CloseBtn" Content="Tutup"
                        Height="38" FontSize="13" FontWeight="SemiBold"
                        Foreground="White" Background="#DC2626"
                        Cursor="Hand" BorderThickness="0"
                        Margin="0,14,0,0"
                        Click="CloseButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#B91C1C"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#991B1B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Border>
</Window>
