<Window x:Class="TrackerAgent.ScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TRACKER-ASSET SCAN"
        Icon="mito-icon.png"
        Width="600" Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Arial Black"
        Background="#FFFFFF">

    <Window.Resources>
        <Style x:Key="BrutalButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Arial Black"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#000000"/>
            <Setter Property="BorderThickness" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" ShadowDepth="6" Direction="315" BlurRadius="0" Opacity="1"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="5">
        <Border.Effect>
            <DropShadowEffect Color="#000000" ShadowDepth="10" Direction="315" BlurRadius="0" Opacity="1"/>
        </Border.Effect>
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#FFFF00" BorderBrush="#000000" BorderThickness="4" Padding="16,12">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" ShadowDepth="5" Direction="315" BlurRadius="0" Opacity="1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="TRACKER-ASSET" FontSize="22" FontWeight="Black" Foreground="#000000"/>
                    <TextBlock x:Name="SubtitleText" Text="DEVICE SCAN" FontSize="14" Foreground="#000000" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1" Margin="0,24,0,0">

                <!-- Idle -->
                <Border x:Name="ConfigPanel" Background="#00FF00" BorderBrush="#000000" BorderThickness="4" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" ShadowDepth="6" Direction="315" BlurRadius="0" Opacity="1"/>
                    </Border.Effect>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SERVER:" Foreground="#000000" FontSize="12" Margin="0,0,0,6"/>
                        <TextBlock x:Name="UrlBox" Foreground="#000000" FontSize="14" Margin="0,0,0,20" TextWrapping="Wrap"/>
                        <TextBlock Text="TOKEN:" Foreground="#000000" FontSize="12" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TokenBox" Foreground="#000000" FontFamily="Courier New" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Progress -->
                <Border x:Name="StatusPanel" Background="#FF00FF" BorderBrush="#000000" BorderThickness="4" Padding="20" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" ShadowDepth="6" Direction="315" BlurRadius="0" Opacity="1"/>
                    </Border.Effect>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Text="SCANNING DEVICE..." Foreground="#000000" FontSize="16"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,0,0,24"/>
                        <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="4" Height="30" ClipToBounds="True">
                            <Rectangle x:Name="ScanProgressFill" Fill="#FFFF00" Width="0" HorizontalAlignment="Left"/>
                        </Border>
                        <TextBlock x:Name="PercentText" Text="0%" Foreground="#000000" FontSize="18"
                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Result -->
                <Border x:Name="ResultPanel" Background="#00FFFF" BorderBrush="#000000" BorderThickness="4" Padding="20" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" ShadowDepth="6" Direction="315" BlurRadius="0" Opacity="1"/>
                    </Border.Effect>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="ResultText" FontSize="18" FontWeight="Black" Foreground="#000000"
                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock x:Name="ResultDetail" FontSize="13" Foreground="#000000"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="420"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Footer -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,24,0,0">
                <Button x:Name="ScanButton" Content="SCAN NOW"
                        MinWidth="140"
                        Style="{StaticResource BrutalButton}"
                        Background="#FFFF00"
                        Click="ScanButton_Click"/>
                <Button x:Name="CloseButton" Content="CLOSE"
                        MinWidth="120" Visibility="Collapsed" Margin="20,0,0,0"
                        Style="{StaticResource BrutalButton}"
                        Background="#FF00FF"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
