<Window x:Class="TrackerAgent.ScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TRACKER-ASSET SCAN"
        Icon="mito-icon.png"
        Width="620" Height="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="#F3F6FB">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#D9E4F3"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#0F172A"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#475569"/>
        <SolidColorBrush x:Key="SoftAccent" Color="#E0F2FE"/>
        <SolidColorBrush x:Key="SuccessAccent" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="PrimaryAction" Color="#2563EB"/>
        <SolidColorBrush x:Key="PrimaryActionText" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="MutedButton" Color="#E2E8F0"/>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryActionText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource PrimaryAction}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F3F6FB" Margin="18">
        <Border Background="#FFFFFF"
                BorderBrush="#DDE7F5"
                BorderThickness="1"
                CornerRadius="20">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="18" Opacity="0.12" Color="#0F172A"/>
            </Border.Effect>
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#EFF6FF" BorderBrush="#D5E4FF" BorderThickness="1" CornerRadius="16" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="TRACKER-ASSET" FontSize="22" FontWeight="SemiBold" Foreground="#0F172A"/>
                        <TextBlock x:Name="SubtitleText" Text="Device scan" FontSize="13" Foreground="#475569" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Border x:Name="ConfigPanel" Background="#F8FAFC" BorderBrush="#DDE7F5" BorderThickness="1" CornerRadius="16" Padding="20">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Server" Foreground="#475569" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock x:Name="UrlBox" Foreground="#0F172A" FontSize="14" Margin="0,0,0,18" TextWrapping="Wrap"/>
                            <TextBlock Text="Token" Foreground="#475569" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TokenBox" Foreground="#0F172A" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="StatusPanel" Background="#F0FDF4" BorderBrush="#C7F9D5" BorderThickness="1" CornerRadius="16" Padding="20" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="StatusText" Text="Scanning device..." Foreground="#14532D" FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20"/>
                            <Border Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1" Height="12" CornerRadius="6" ClipToBounds="True">
                                <Rectangle x:Name="ScanProgressFill" Fill="#22C55E" Width="0" HorizontalAlignment="Left" RadiusX="6" RadiusY="6"/>
                            </Border>
                            <TextBlock x:Name="PercentText" Text="0%" Foreground="#14532D" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ResultPanel" Background="#EFF6FF" BorderBrush="#C7D7FF" BorderThickness="1" CornerRadius="16" Padding="20" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="ResultText" FontSize="18" FontWeight="SemiBold" Foreground="#1E3A8A"
                                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock x:Name="ResultDetail" FontSize="13" Foreground="#334155"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button x:Name="ScanButton" Content="Scan Now"
                            MinWidth="150"
                            Style="{StaticResource ModernButton}"
                            Background="#2563EB"
                            Click="ScanButton_Click"/>
                    <Button x:Name="CloseButton" Content="Close"
                            MinWidth="120" Visibility="Collapsed" Margin="12,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="#94A3B8"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
