<Window x:Class="TrackerAgent.ScanWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Title="TRACKER-ASSET SCAN"
         Icon="mito-icon.png"
         Width="640" Height="500"
         MinWidth="640" MinHeight="500"
         SizeToContent="Height"
         WindowStartupLocation="CenterScreen"
         ResizeMode="NoResize"
         FontFamily="Segoe UI"
         UseLayoutRounding="True"
         TextOptions.TextFormattingMode="Display"
         Background="Transparent"
         WindowStyle="None"
         AllowsTransparency="True">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#0F1117"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#1E293B"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#94A3B8"/>
        <SolidColorBrush x:Key="SoftAccent" Color="#7F1D1D"/>
        <SolidColorBrush x:Key="SuccessAccent" Color="#14532D"/>
        <SolidColorBrush x:Key="PrimaryAction" Color="#DC2626"/>
        <SolidColorBrush x:Key="PrimaryActionHover" Color="#B91C1C"/>
        <SolidColorBrush x:Key="PrimaryActionText" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="MutedButton" Color="#475569"/>

        <Color x:Key="GlowColor">#DC2626</Color>
        <Thickness x:Key="ZeroThickness" Left="0" Top="0" Right="0" Bottom="0"/>

        <Storyboard x:Key="GlowLoop">
            <ColorAnimation Storyboard.TargetName="CardGlow"
                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                            From="#DC2626" To="#FF6B6B"
                            Duration="0:0:2.5"
                            AutoReverse="True"
                            RepeatBehavior="Forever"
                            AccelerationRatio="0.2"
                            DecelerationRatio="0.8"/>
            <DoubleAnimation Storyboard.TargetName="CardGlow"
                             Storyboard.TargetProperty="Opacity"
                             From="0.3" To="0.5"
                             Duration="0:0:2.5"
                             AutoReverse="True"
                             RepeatBehavior="Forever"/>
        </Storyboard>

        <Storyboard x:Key="PulseStatus">
            <DoubleAnimation Storyboard.TargetName="StatusDotGlow"
                             Storyboard.TargetProperty="Opacity"
                             From="0.3" To="0.8"
                             Duration="0:0:1"
                             AutoReverse="True"
                             RepeatBehavior="Forever"/>
            <ColorAnimation Storyboard.TargetName="StatusDotFill"
                            Storyboard.TargetProperty="Color"
                            From="#12B76A" To="#22C526"
                            Duration="0:0:1"
                            AutoReverse="True"
                            RepeatBehavior="Forever"/>
        </Storyboard>

        <Storyboard x:Key="FloatIn">
            <DoubleAnimation Storyboard.TargetName="MainCard"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.4"/>
            <DoubleAnimation Storyboard.TargetName="MainCard"
                             Storyboard.TargetProperty="(TranslateTransform.Y)"
                             From="20" To="0"
                             Duration="0:0:0.4"/>
            <DoubleAnimation Storyboard.TargetName="HeaderGlow"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="0.8"
                             Duration="0:0:0.6"
                             BeginTime="0:0:0.1"/>
        </Storyboard>

        <Storyboard x:Key="ScanActive">
            <DoubleAnimation Storyboard.TargetName="ScanProgressFill"
                             Storyboard.TargetProperty="Width"
                             To="460"
                             Duration="0:0:2"
                             AccelerationRatio="0.3"
                             DecelerationRatio="0.3"/>
            <ColorAnimation Storyboard.TargetName="ScanProgressFill"
                            Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"
                            From="#16A34A" To="#22C526"
                            Duration="0:0:2"/>
        </Storyboard>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryActionText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Background" Value="{StaticResource PrimaryAction}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="12" Opacity="0.3" Color="#DC2626"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource PrimaryActionHover}"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.04" ScaleY="1.04"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#7F1D1D"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.5"/>
                                <Setter TargetName="BtnBorder" Property="Background" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConfigButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                x:Name="CfgBtn">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CfgBtn" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="Transparent">
        <Border x:Name="MainCard"
                Background="#0F1117"
                BorderBrush="#1E293B" BorderThickness="1"
                CornerRadius="20"
                RenderTransformOrigin="0.5,0.5">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="40" Opacity="0.2" Color="#000000"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardTranslate" Y="0"/>
            </Border.RenderTransform>

            <Grid Margin="24,22,24,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border x:Name="HeaderGlow"
                        Grid.Row="0"
                        CornerRadius="14"
                        Opacity="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#DC2626" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="0.5"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Border x:Name="CardGlow"
                        Grid.Row="0"
                        Background="#111827"
                        BorderBrush="#DC2626" BorderThickness="1"
                        CornerRadius="14">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="16" Opacity="0.25" Color="#DC2626"/>
                    </Border.Effect>
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#DC2626" Offset="0"/>
                                    <GradientStop Color="#B91C1C" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="12" Opacity="0.4" Color="#DC2626"/>
                            </Border.Effect>
                            <TextBlock Text="M"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="TRACKER-ASSET"
                                       FontSize="20" FontWeight="SemiBold"
                                       Foreground="White"/>
                            <TextBlock x:Name="SubtitleText"
                                       Text="Device scan and monitoring"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryText}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button x:Name="ConfigBtn" Grid.Column="2"
                                Style="{StaticResource ConfigButton}"
                                Content="⚙"
                                ToolTip="Reload configuration"/>
                    </Grid>
                </Border>

                <!-- Server + Token Panel -->
                <Border x:Name="ConfigPanel"
                        Grid.Row="2"
                        Background="#111827"
                        BorderBrush="#1E293B" BorderThickness="1"
                        CornerRadius="14">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="16" Opacity="0.15" Color="#DC2626"/>
                    </Border.Effect>
                    <Border Padding="20">
                        <StackPanel>
                            <TextBlock Text="SERVER"
                                       Foreground="{StaticResource SecondaryText}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <TextBlock x:Name="UrlBox"
                                       Foreground="{StaticResource PrimaryText}"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Text="—"/>

                            <TextBlock Text="TOKEN"
                                       Foreground="{StaticResource SecondaryText}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Margin="0,16,0,6"/>
                            <TextBlock x:Name="TokenBox"
                                       Foreground="{StaticResource PrimaryText}"
                                       FontFamily="Consolas" FontSize="12"
                                       TextWrapping="Wrap"
                                       Text="—"/>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- Status Panel -->
                <Border x:Name="StatusPanel"
                        Grid.Row="4"
                        Background="#0F1117"
                        BorderBrush="#1E293B" BorderThickness="1"
                        CornerRadius="14"
                        Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="20" Opacity="0.2" Color="#12B76A"/>
                    </Border.Effect>
                    <Border Padding="20">
                        <StackPanel>
                            <TextBlock x:Name="StatusText"
                                       Text="Scanning device…"
                                       Foreground="#4ADE80"
                                       FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="480"
                                       Margin="0,0,0,18"/>

                            <Border x:Name="ScanProgressTrack"
                                    Background="#1E293B"
                                    BorderBrush="#334155" BorderThickness="1"
                                    Height="12"
                                    CornerRadius="6">
                                <Border.Clip>
                                    <RectangleGeometry Rect="0,0,460,12"/>
                                </Border.Clip>
                                <Rectangle x:Name="ScanProgressFill"
                                           Fill="#16A34A"
                                           Width="0"
                                           RadiusX="6" RadiusY="6"
                                           HorizontalAlignment="Left"/>
                            </Border>

                            <Ellipse x:Name="StatusDotGlow"
                                     Width="14" Height="14"
                                     HorizontalAlignment="Center"
                                     Margin="0,16,0,0"
                                     Opacity="0">
                                <Ellipse.Fill>
                                    <SolidColorBrush x:Name="StatusDotFill" Color="#12B76A"/>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="8" Opacity="0.5" Color="#12B76A"/>
                                </Ellipse.Effect>
                            </Ellipse>

                            <TextBlock x:Name="PercentText"
                                       Text="0%"
                                       Foreground="#4ADE80"
                                       FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Right"
                                       Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- Result Panel -->
                <Border x:Name="ResultPanel"
                        Grid.Row="4"
                        Background="#0F1117"
                        BorderBrush="#1E293B" BorderThickness="1"
                        CornerRadius="14"
                        Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="20" Opacity="0.2" Color="#DC2626"/>
                    </Border.Effect>
                    <Border Padding="24">
                        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse x:Name="ResultIcon"
                                     Width="56" Height="56"
                                     Margin="0,0,0,18">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#DC2626" Offset="0"/>
                                        <GradientStop Color="#B91C1C" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="16" Opacity="0.4" Color="#DC2626"/>
                                </Ellipse.Effect>
                            </Ellipse>

                            <TextBlock x:Name="ResultGlyph"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="i"/>

                            <TextBlock x:Name="ResultText"
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Margin="0,70,0,0"/>

                            <TextBlock x:Name="ResultDetail"
                                       FontSize="13"
                                       Foreground="#CBD5E1"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="460"
                                       Margin="0,95,0,0"/>
                        </Grid>
                    </Border>
                </Border>

                <!-- Buttons -->
                <StackPanel Grid.Row="6"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,4">
                    <Button x:Name="ScanButton"
                            Content="Scan Now"
                            MinWidth="160"
                            Style="{StaticResource ModernButton}"
                            Click="ScanButton_Click"/>

                    <Button x:Name="CloseButton"
                            Content="Close"
                            MinWidth="130"
                            Visibility="Collapsed"
                            Margin="14,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource MutedButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource FloatIn}"/>
        </EventTrigger>
    </Window.Triggers>
</Window>