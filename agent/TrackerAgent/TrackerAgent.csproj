<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TrackerAgent</RootNamespace>
    <AssemblyName>TrackerAgent</AssemblyName>
        <!-- 1.6.3: elevation runs off the command loop, with a progress ping, a
             5-minute bound, a one-at-a-time guard and a single-close tray stop.
             1.7.0: Wake on LAN (MAC reported to the server), remote power
             actions (restart / shutdown / logoff via shutdown.exe) and printer
             inventory in the fingerprint report.
             1.7.1: the two nested inventory lists now go out snake_case, so the
             printer driver/port/network/offline fields reach the server instead
             of being dropped by its validation; and the tray menu is built once,
             not twice.
             1.7.2: those same lists are read back with snake_case options too.
             1.7.1 wrote driver_name and then read it with camelCase settings,
             where case-insensitive matching still cannot bridge the underscore,
             so every multi-word field came back null and was posted as
             "driver_name": null. Software lost installed_at the same way. -->
          <Version>1.7.9</Version><!-- 1.7.3: revoked token fix in registration (isUsable -> is_active check)
              1.7.4: futuristis UI redesign for StatusWindow and ScanWindow
              1.7.5: UI rebuild with correct version
              1.7.6: Fix is_elevated reporting - tray now checks IsSystemDaemonAlive()
                    so devices with a SYSTEM daemon show 'admin' on Live Fleet
               1.7.7: first-install asset enrollment form, secure asset bootstrap API,
                    and visible step-by-step installer/update progress -->
    <Company>MITO Group</Company>
    <Product>TRACKER-ASSET Audit Agent</Product>
    <Description>MITO Group Audit Agent Installer</Description>
    <ApplicationIcon>tracker-agent.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- The token lookup and the scan-result printer are internal, not public
       API. The offline harness in agent/TrackerAgent.Tests links against them
       directly, which is the point: the two defects it pins (a daemon that
       ignored the stored token, and a scan of an empty mismatch set that threw
       before it could ack) lived in exactly those helpers. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>TrackerAgent.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="mito-logo-white.png" />
    <Resource Include="mito-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
